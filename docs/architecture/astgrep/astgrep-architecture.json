  "cards": [
    {
      "dot": "cyan",
      "title": "SQL 方言分发",
      "items": [
        "GaussDB/OpenGauss → ogsql-parser（git tag 锁定 v0.8.31）",
        "PolarDB-MySQL → sqlparser-rs 0.62（MySqlDialect）",
        "标准 SQL → tree-sitter-sequel 0.3.11；--dialect 一键切换"
      ]
    },
    {
      "dot": "emerald",
      "title": "污点分析",
      "items": [
        "Source→Sink 流追踪，支持 sanitizer 净化",
        "在 AST 上构建 CFG / 调用图 / 常量传播",
        "Source/Sink 模式复用 matcher 精确匹配"
      ]
    },
    {
      "dot": "violet",
      "title": "嵌入式 SQL 预处理",
      "items": [
        "从 Java 注解/字符串与 MyBatis XML 抽取 SQL 片段",
        "片段按方言重新解析，用 SQL 语义规则匹配",
        "无需编写宿主语言模式"
      ]
    },
    {
      "dot": "amber",
      "title": "规则与输出",
      "items": [
        "YAML 声明式规则：模式 + 元变量 + 条件 + taint 模式",
        "方言感知 rules.dialects 字段；内置 GaussDB 14 / PolarDB-MySQL 6 条",
        "输出：JSON / SARIF / Text / HTML / Markdown / Semgrep"
      ]
    },
    {
      "dot": "rose",
      "title": "工程边界与计划",
      "items": [
        "MCP 子命令在根 main.rs 拦截，规避 cli↔mcp 循环依赖",
        "并行分析：rayon 线程池 + tokio；web 可选 feature：auth/metrics/database",
        "消费方：CI/CD（SARIF）、AI 助手（MCP 4 工具）、IDE 集成规划中"
      ]
    }
  ]
