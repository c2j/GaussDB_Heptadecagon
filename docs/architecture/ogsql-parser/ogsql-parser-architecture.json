  "cards": [
    {
      "dot": "cyan",
      "title": "解析管线与特性门控",
      "items": [
        "纯手写递归下降解析器，不依赖解析器生成器；核心零外部运行时依赖",
        "features 门控：cli / serve / serve-minimal / tui / mcp / ibatis / java / full",
        "Windows 7 Tier-3 目标：nightly + -Zbuild-std 静态链接 CRT",
        "CLI 12 个子命令：parse/tokenize/format/validate/json2sql/parse-xml/parse-java/validate-xml/validate-java/serve/playground/mcp"
      ]
    },
    {
      "dot": "violet",
      "title": "语义分析与校验",
      "items": [
        "动态 SQL 变量追踪 + EXECUTE IMMEDIATE 参数化重写",
        "MERGE 语义校验 · PACKAGE 一致性 · PL 变量/未定义函数严格校验",
        "返回游标分析 · 事务分析 · 查询指纹 · Schema 加载（索引感知）"
      ]
    },
    {
      "dot": "rose",
      "title": "集成与格式化",
      "items": [
        "iBatis/MyBatis：XML 动态 SQL AST、变体展开、Java 参数类型推断（__XML_PARAM_*__）",
        "Java 源码：tree-sitter-java 提取 SQL（字符串拼接/注解/方法调用/PreparedStatement 回填）",
        "两段式格式化：结构化 AST 重排 + token 级配置（关键字大小写/逗号风格/行宽）"
      ]
    },
    {
      "dot": "amber",
      "title": "接口与外部依赖",
      "items": [
        "MCP 7 工具：parse / tokenize / format / validate / json2sql / parse_xml / parse_java",
        "HTTP：/api/parse|json2sql|format|tokenize|validate|parse-xml|validate-xml|parse-java|validate-java + Swagger/SARIF/multipart",
        "可选依赖全 feature 门控：axum/tokio/ratatui/rmcp/tree-sitter-java/quick-xml/clap",
        "多编码：UTF-8/GB18030/BIG5/EUC-JP/EUC-KR/UTF-16（encoding_rs）"
      ]
    },
    {
      "dot": "slate",
      "title": "消费方与计划",
      "items": [
        "下游 AST 消费：ogexplain-analyzer / metamorphosis / codeweb / astgrep，AST 变更影响面大",
        "回归：1409/1409 openGauss 回归用例 + 1980+ 单元测试；lib/openGauss-server 子模块参考",
        "计划：GaussDB 语法覆盖持续扩展、strict 校验增强"
      ]
    }
  ]
