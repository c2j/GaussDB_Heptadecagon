  "cards": [
    {
      "dot": "cyan",
      "title": "增量机制",
      "items": [
        "manifest.json 记录每个 SQL 文件 SHA-256 内容哈希，仅重新解析变更文件",
        "AST JSON 缓存于 .fluxgauss/ast/，未变更文件直接复用缓存 AST",
        "跨包调用传递依赖追踪：被调用包变更时自动触发调用方重生成",
        "--resume 基于 gen-checkpoint.json 断点续做，跳过已成功生成的包"
      ]
    },
    {
      "dot": "violet",
      "title": "双引擎与特性门控",
      "items": [
        "Python 引擎（~15300 行，评级 A-）：功能完整，支持 DDL 预扫描与过期包清理",
        "Rust 引擎（~16700 行，评级 B+）：Rayon 多线程，适合 1000-30000 个 SP 大批量",
        "两引擎共享同一 YAML 配置格式（fluxgauss.yaml）与增量/测试生成能力",
        "PyInstaller 打包为独立二进制，可通过 fluxgauss.spec 一键分发"
      ]
    },
    {
      "dot": "amber",
      "title": "内部依赖",
      "items": [
        "validate 与 parse 共用同一 ogsql-parser 二进制（OGSQL_BIN / PATH 解析）",
        "Rust 引擎通过 Cargo git 依赖直接链接 ogsql-parser v0.8.32 crate",
        "集成测试依赖 Docker + Testcontainers 启动 opengauss 镜像",
        "生成项目需 Java 17 + Maven 做 mvn compile / mvn test 编译验证"
      ]
    },
    {
      "dot": "emerald",
      "title": "消费方",
      "items": [
        "AI 客户端（Claude Desktop / Cursor 等）经 --mcp stdio 调用 validate_sql / convert_sql",
        "convert_sql 先自动执行校验，有错误即中止；skip_validation: true 可强制转换",
        "ogsql-parser 自身也提供 MCP 服务器（ogsql-mcp）与 REST API（ogsql serve，端口 9527）",
        "CI/CD 构建 Linux/macOS/Windows 二进制，双引擎回归测试同跑"
      ]
    },
    {
      "dot": "rose",
      "title": "生成产物与规划",
      "items": [
        "每个包生成 4 个文件：{Name}Service.java / Mapper.java / Mapper.xml / ServiceTest.java",
        "pom.xml、application.yml、DemoApplication 等骨架仅缺失时写入，重复生成需先删除",
        "生成代码携带源码溯源注释，--debug 注入精确 SQL 行号便于逐行比对",
        "docs/plans 规划中：动态 SQL 更多场景、Rust 模块化 statements/ 子模块重构"
      ]
    }
  ]
}
